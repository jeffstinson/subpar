# Subpar OS — isolated environment only
# Never reuse Stince AI credentials, projects, buckets, OAuth apps or webhook secrets.

SUBPAR_DATA_MODE=demo
SUBPAR_MUTATIONS_ENABLED=false
SUBPAR_ALLOW_SYNTHETIC_SEED=false
SUBPAR_AUTH_MODE=demo
SUBPAR_INTERNAL_AUTH_ENABLED=false
SUBPAR_PORTAL_AUTH_ENABLED=false
NEXT_PUBLIC_SUBPAR_ENV=preview
NEXT_PUBLIC_SUBPAR_APP_URL=https://subpar-two.vercel.app

# Global live-data gate. Keep false until NDA / real-data approval and synthetic validation are complete.
SUBPAR_REAL_DATA_APPROVED=false
SUBPAR_INTEGRATION_STAGING_ENABLED=false
# Provider OAuth connection probes are explicit and separate from read/sync/apply gates.
SUBPAR_CONNECTION_TESTS_ENABLED=false
# Historical import apply is a separate switch from live webhooks/sync.
SUBPAR_IMPORT_APPLY_ENABLED=false

# Supabase — create a dedicated Subpar project before enabling supabase mode.
# The URL may use either variable below. Service-role key is server-only.
SUBPAR_SUPABASE_URL=
NEXT_PUBLIC_SUBPAR_SUPABASE_URL=
NEXT_PUBLIC_SUBPAR_SUPABASE_ANON_KEY=
SUBPAR_SUPABASE_SERVICE_ROLE_KEY=

# Private storage buckets. Keep all buckets private.
SUBPAR_BUCKET_STOCK_FILES=subpar-stock-files
SUBPAR_BUCKET_REVISIONS=subpar-revisions
SUBPAR_BUCKET_LOGS=subpar-logs
SUBPAR_BUCKET_PARAMETER_PACKS=subpar-parameter-packs
SUBPAR_BUCKET_CUSTOMER_FILES=subpar-customer-files
# 32+ random characters; server-only. Signs upload-finalization tickets.
SUBPAR_FILE_TICKET_SECRET=

# Wix — dedicated Subpar app/webhook credentials.
# Wix OAuth app tokens require the app's installation instance ID for Doug's site.
SUBPAR_WIX_APP_ID=
SUBPAR_WIX_APP_SECRET=
SUBPAR_WIX_INSTANCE_ID=
SUBPAR_WIX_WEBHOOK_PUBLIC_KEY=
# Historical/API reads are separate from webhook receive and database apply.
SUBPAR_WIX_READ_ENABLED=false
SUBPAR_WIX_WEBHOOK_ENABLED=false
# Separate apply gate: signed webhook planning can be enabled before order/customer/intake mutations.
SUBPAR_WIX_APPLY_ENABLED=false
SUBPAR_WIX_BACKFILL_MONTHS=36
SUBPAR_WIX_IMPORT_BATCH_SIZE=100

# Gmail / Google OAuth — dedicated Subpar OAuth client.
SUBPAR_GOOGLE_CLIENT_ID=
SUBPAR_GOOGLE_CLIENT_SECRET=
SUBPAR_GOOGLE_REFRESH_TOKEN=
SUBPAR_GMAIL_ACCOUNT=
SUBPAR_GMAIL_PUBSUB_TOPIC=
SUBPAR_GMAIL_SYNC_ENABLED=false
SUBPAR_GMAIL_SEND_ENABLED=false
SUBPAR_GMAIL_BACKFILL_MONTHS=24
SUBPAR_GMAIL_IMPORT_BATCH_SIZE=250

# Optional post-closeout scheduler.
# When enabled, the worker only stages due Gmail drafts. It never bypasses tuner approval/provider-send gates.
SUBPAR_FOLLOWUP_AUTOMATION_ENABLED=false
# 32+ random characters used only to authorize the cron-ready follow-up worker endpoint.
SUBPAR_CRON_SECRET=

# Optional ingestion/integration secrets.
SUBPAR_ECUTEK_WEBHOOK_SECRET=
SUBPAR_DATAZAP_TOKEN=
