# Subpar OS — isolated environment only
# Never reuse Stince AI credentials, projects, buckets, OAuth apps or webhook secrets.

SUBPAR_DATA_MODE=demo
SUBPAR_MUTATIONS_ENABLED=false
SUBPAR_ALLOW_SYNTHETIC_SEED=false
SUBPAR_AUTH_MODE=demo
SUBPAR_INTERNAL_AUTH_ENABLED=false
SUBPAR_PORTAL_AUTH_ENABLED=false
NEXT_PUBLIC_SUBPAR_ENV=preview
NEXT_PUBLIC_SUBPAR_APP_URL=https://subpar-two.vercel.app

# Supabase — create a dedicated Subpar project before enabling supabase mode.
# The URL may use either variable below. Service-role key is server-only.
SUBPAR_SUPABASE_URL=
NEXT_PUBLIC_SUBPAR_SUPABASE_URL=
NEXT_PUBLIC_SUBPAR_SUPABASE_ANON_KEY=
SUBPAR_SUPABASE_SERVICE_ROLE_KEY=

# Private storage buckets. Keep all buckets private.
SUBPAR_BUCKET_STOCK_FILES=subpar-stock-files
SUBPAR_BUCKET_REVISIONS=subpar-revisions
SUBPAR_BUCKET_LOGS=subpar-logs
SUBPAR_BUCKET_PARAMETER_PACKS=subpar-parameter-packs
SUBPAR_BUCKET_CUSTOMER_FILES=subpar-customer-files
# 32+ random characters; server-only. Signs upload-finalization tickets.
SUBPAR_FILE_TICKET_SECRET=

# Wix — dedicated Subpar app/webhook credentials.
SUBPAR_WIX_APP_ID=
SUBPAR_WIX_APP_SECRET=
SUBPAR_WIX_WEBHOOK_SECRET=

# Gmail / Google OAuth — dedicated Subpar OAuth client.
SUBPAR_GOOGLE_CLIENT_ID=
SUBPAR_GOOGLE_CLIENT_SECRET=
SUBPAR_GOOGLE_REFRESH_TOKEN=
SUBPAR_GMAIL_ACCOUNT=

# Optional ingestion/integration secrets.
SUBPAR_ECUTEK_WEBHOOK_SECRET=
SUBPAR_DATAZAP_TOKEN=
